---
// Formulario que reenvía al correo del programa vía Web3Forms, sin salir de
// la página. Lo usan Contáctenos y PQRS: los campos van en el slot; aquí viven
// las claves, las capas contra bots, la validación en español y el envío.
// Check: node scripts/probar-form.mjs <url>  (ver DESIGN.md → Formulario)
interface Props {
  etiqueta: string; // aria-label del formulario
  asunto: string; // asunto del correo que llega al programa
  boton: string;
  exito: string; // mensaje tras un envío correcto
}
const { etiqueta, asunto, boton, exito } = Astro.props;

// Clave de Web3Forms. Mientras sea el marcador, el envío falla de forma
// controlada y se muestra el correo institucional como alternativa.
const ACCESS_KEY = 'PENDIENTE_ACCESS_KEY';

// Cloudflare Turnstile: la defensa real contra bots guiados por IA. Mientras
// sea el marcador el formulario funciona sin él (con las demás capas), pero
// queda expuesto a spam automatizado.
const TURNSTILE_KEY = 'PENDIENTE_TURNSTILE_KEY';
const turnstileActivo = !TURNSTILE_KEY.startsWith('PENDIENTE');
---

<form
  class="form"
  data-web3
  data-exito={exito}
  method="POST"
  action="https://api.web3forms.com/submit"
  aria-label={etiqueta}
>
  <input type="hidden" name="access_key" value={ACCESS_KEY} />
  <input type="hidden" name="subject" value={asunto} />
  <input type="hidden" name="from_name" value="Sitio del Doctorado en Ingeniería" />

  {/* Trampas para bots. Van fuera del alcance del teclado y de los
      lectores de pantalla, así que una persona nunca las ve ni las llena;
      un bot que rellena todo por defecto sí, y ahí se delata.
      `botcheck` lo valida Web3Forms del lado del servidor. */}
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />
  <div class="visually-hidden" aria-hidden="true">
    <label for="sitio-web">No llenar este campo</label>
    <input id="sitio-web" name="sitio_web" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <slot />

  {
    turnstileActivo && (
      <div class="turnstile-caja">
        <div class="cf-turnstile" data-sitekey={TURNSTILE_KEY} data-language="es" />
      </div>
    )
  }

  <button class="btn btn-primary" type="submit">
    {boton}
    <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
  </button>

  {/* El resultado se anuncia aquí mismo. role=status para lectores de pantalla. */}
  <p class="form-estado" role="status" aria-live="polite" hidden></p>

  <p class="form-nota">
    Los datos enviados se tratan según la política de protección de datos personales de la
    Universidad Distrital Francisco José de Caldas.
  </p>
</form>

{
  turnstileActivo && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />
  )
}

<style>
  /* Dentro de la prosa (PQRS) heredaría la serif: el formulario es interfaz */
  .form {
    font-family: var(--font-sans);
  }

  /* Los campos llegan por el slot (otro ámbito de estilos): van con :global
     pero siempre dentro de .form */
  .form :global(.fila) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form :global(.field) {
    margin-bottom: 1.4rem;
  }

  .form :global(label) {
    display: block;
    font-weight: 650;
    font-size: 0.9rem;
    margin-bottom: 0.45rem;
  }

  .form :global(input:not([type='hidden']):not([type='checkbox'])),
  .form :global(textarea),
  .form :global(select) {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--c-line);
    border-radius: 0;
    background: var(--c-bg);
    color: var(--c-ink);
    transition:
      border-color 180ms var(--ease-out-quint),
      box-shadow 180ms var(--ease-out-quint);
  }

  .form :global(textarea) {
    resize: vertical;
    min-height: 9rem;
  }

  .form :global(input::placeholder),
  .form :global(textarea::placeholder) {
    color: var(--c-ink-soft);
    opacity: 1;
  }

  .form :global(input:hover),
  .form :global(textarea:hover),
  .form :global(select:hover) {
    border-color: var(--c-ink-soft);
  }

  .form :global(input:focus),
  .form :global(textarea:focus),
  .form :global(select:focus) {
    outline: none;
    border-color: var(--c-crimson);
    box-shadow: 0 0 0 3px var(--c-crimson-soft);
  }

  /* Casilla con su texto al lado (autorización de datos) */
  .form :global(.casilla) {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 1.4rem;
    font-weight: 400;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form :global(.casilla input) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    accent-color: var(--c-crimson);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn svg {
    transition: translate 150ms var(--ease-out-quint);
  }

  .btn:hover svg {
    translate: 2px -2px;
  }

  .form-nota {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  .turnstile-caja {
    margin-bottom: 1.25rem;
  }

  /* Resultado del envío: verde institucional para éxito, carmesí para error */
  .form-estado {
    margin-top: 1.1rem;
    padding: 0.9rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .form-estado.ok {
    background: oklch(0.95 0.04 150);
    color: oklch(0.35 0.09 150);
  }

  .form-estado.error {
    background: var(--c-crimson-soft);
    color: var(--c-crimson-dark);
  }

  .form-estado :global(a) {
    color: inherit;
  }

  @media (max-width: 820px) {
    .form :global(.fila) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const CORREO = 'doctoradoing@udistrital.edu.co';

  // El navegador muestra sus avisos de validación en SU idioma, no en el de
  // la página: se reemplazan por mensajes propios en español.
  type Campo = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  const mensajeDe = (campo: Campo) => {
    const v = campo.validity;
    if (v.valueMissing && campo instanceof HTMLInputElement && campo.type === 'checkbox')
      return 'Marca esta casilla para continuar.';
    if (v.valueMissing && campo instanceof HTMLSelectElement) return 'Elige una opción.';
    if (v.valueMissing) return 'Completa este campo para continuar.';
    if (v.typeMismatch && campo.type === 'email')
      return 'Escribe un correo electrónico válido, por ejemplo nombre@correo.com';
    return 'Revisa este campo.';
  };

  document.querySelectorAll<HTMLFormElement>('form[data-web3]').forEach((form) => {
    const estado = form.querySelector<HTMLParagraphElement>('.form-estado')!;
    const boton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const exito = form.dataset.exito ?? 'Mensaje enviado.';

    form.querySelectorAll<Campo>('[required]').forEach((campo) => {
      campo.addEventListener('invalid', () => campo.setCustomValidity(mensajeDe(campo)));
      // Sin esto el mensaje se queda pegado aunque el campo ya sea válido.
      // `change` además cubre el autocompletado del navegador.
      const limpiar = () => campo.setCustomValidity('');
      campo.addEventListener('input', limpiar);
      campo.addEventListener('change', limpiar);
    });

    const mostrar = (texto: string, ok: boolean) => {
      estado.innerHTML = texto;
      estado.classList.toggle('ok', ok);
      estado.classList.toggle('error', !ok);
      estado.hidden = false;
    };

    // ── Defensa contra bots (capas que no dependen de servicios externos) ──
    // Ninguna es infalible por sí sola; el filtro fuerte es Turnstile.
    const cargadaEn = Date.now();
    const SEGUNDOS_MINIMOS = 3; // una persona no llena el formulario más rápido
    const trampa = form.querySelector<HTMLInputElement>('#sitio-web');
    let ultimoEnvio = 0;

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      // Trampa llena = bot. Se finge éxito para no darle pistas de qué falló.
      if (trampa?.value) {
        mostrar(exito, true);
        form.reset();
        return;
      }

      // Llenado instantáneo = automatizado
      if ((Date.now() - cargadaEn) / 1000 < SEGUNDOS_MINIMOS) {
        mostrar('Tómate un momento para revisar el mensaje antes de enviarlo.', false);
        return;
      }

      // Evita reenvíos en ráfaga (y el doble clic accidental)
      if (Date.now() - ultimoEnvio < 15000) {
        mostrar('Ya recibimos tu mensaje. Espera un momento antes de enviar otro.', false);
        return;
      }

      estado.hidden = true;
      boton.disabled = true;
      // innerHTML, no textContent: el botón lleva el ícono de flecha dentro
      const contenidoOriginal = boton.innerHTML;
      boton.textContent = 'Enviando…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        ultimoEnvio = Date.now();
        mostrar(exito, true);
        form.reset();
      } catch {
        mostrar(
          `No pudimos enviar el mensaje. Escríbenos directamente a <a href="mailto:${CORREO}">${CORREO}</a> o llámanos al (+57) 601 323 9300, extensión 1419.`,
          false
        );
      } finally {
        boton.disabled = false;
        boton.innerHTML = contenidoOriginal;
      }
    });
  });
</script>
