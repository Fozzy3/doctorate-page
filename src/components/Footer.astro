---
import { sections } from '../data/nav';

// Cuatro columnas curadas; el resto de rutas vive en los dropdowns del header
const columnas = [
  {
    label: 'El programa',
    links: [
      { href: '/acerca-del-doctorado/', label: 'Acerca del doctorado' },
      { href: '/plan-general-de-estudios/', label: 'Plan de estudios' },
      { href: '/normatividad/', label: 'Normatividad' },
      { href: '/calendario-de-actividades-2026/', label: 'Calendario 2026' },
      { href: '/preguntas-frecuentes-doctorado/', label: 'Preguntas frecuentes' },
    ],
  },
  {
    label: 'Admisiones y trámites',
    links: [
      { href: '/admisiones-doctorado/', label: 'Proceso de admisión' },
      { href: '/resultados-admisiones-2026-3/', label: 'Resultados 2026-III' },
      { href: '/formatos/', label: 'Formatos' },
      { href: '/solicitudes/', label: 'Solicitudes' },
    ],
  },
  {
    label: 'Investigación',
    links: [
      { href: '/grupos-de-investigacion/', label: 'Grupos de investigación' },
      { href: '/proyectos-2/', label: 'Proyectos' },
      { href: '/libros/', label: 'Libros' },
      { href: '/laboratorio-de-microrredes/', label: 'Laboratorio de microrredes' },
    ],
  },
  {
    label: 'Comunidad y CECAD',
    links: [
      { href: '/docentes/', label: 'Docentes' },
      { href: '/estudiantes/', label: 'Estudiantes' },
      { href: '/egresados-2/', label: 'Egresados' },
      { href: '/que-es-el-cecad/', label: 'CECAD' },
    ],
  },
];

// Franja de entidades del Estado (la misma del sitio anterior, en su orden)
const logos = [
  { href: 'https://bogota.gov.co/', src: 'alcaldia-bogota.png', w: 401, alt: 'Alcaldía Mayor de Bogotá' },
  { href: 'https://www.mineducacion.gov.co/portal/', src: 'mineducacion.png', w: 573, alt: 'Ministerio de Educación Nacional' },
  { href: 'https://www.colombiacompra.gov.co/', src: 'colombia-compra-eficiente.jpg', w: 264, alt: 'Colombia Compra Eficiente' },
  { href: 'https://www.veeduriadistrital.gov.co/', src: 'veeduria-distrital.png', w: 293, alt: 'Veeduría Distrital' },
  { href: 'https://www.mintic.gov.co/portal/inicio/', src: 'mintic.png', w: 439, alt: 'Ministerio de Tecnologías de la Información y las Comunicaciones' },
  { href: 'https://gobiernodigital.mintic.gov.co/portal/', src: 'gobierno-digital.png', w: 247, alt: 'Gobierno Digital' },
  { href: 'https://www.sdmujer.gov.co/', src: 'secretaria-mujer.jpg', w: 449, alt: 'Secretaría Distrital de la Mujer' },
  { href: 'https://bogota.gov.co/sdqs/', src: 'bogota-te-escucha.png', w: 244, h: 92, alt: 'Bogotá te escucha' },
  { href: 'https://horalegal.inm.gov.co/', src: 'inm-hora-legal.png', w: 168, alt: 'Instituto Nacional de Metrología: hora legal de Colombia' },
];
---

<footer class="site-footer">
  <div class="footer-logos">
    <ul class="container logos" aria-label="Entidades del Estado">
      {
        logos.map((l) => (
          <li>
            <a href={l.href} rel="external noopener" target="_blank">
              <img src={`/images/logos/${l.src}`} alt={l.alt} width={l.w} height={l.h ?? 112} loading="lazy" decoding="async" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container footer-grid">
    <div class="footer-institucional">
      <img
        src="/images/escudo-ud.png"
        alt="Escudo de la Universidad Distrital Francisco José de Caldas, Acreditación Institucional de Alta Calidad"
        width="298"
        height="94"
        loading="lazy"
      />
      <address>
        Cra. 7 No. 40B-53, Semisótano, Edificio Administrativo<br />
        Bogotá D.C., Colombia<br />
        (+57) 601 323 9300 ext. 1419<br />
        <a href="mailto:doctoradoing@udistrital.edu.co">doctoradoing@udistrital.edu.co</a>
      </address>
      <p class="footer-snies">
        SNIES 101686 · Registro calificado: Resolución No. 5905 del 7 de junio de 2019 (7 años)
      </p>
      <ul class="footer-social" aria-label="Redes sociales del programa">
        <li>
          <a href="https://www.facebook.com/doctoradoingud/" rel="external noopener">Facebook</a>
        </li>
        <li>
          <a href="https://www.instagram.com/doctoradoingud/" rel="external noopener">Instagram</a>
        </li>
        <li>
          <a href="https://twitter.com/doctoradoing_ud" rel="external noopener">X (Twitter)</a>
        </li>
      </ul>
    </div>

    {
      columnas.map((col) => (
        <nav aria-label={col.label}>
          <h2>{col.label}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>

  <div class="footer-legal">
    <div class="container footer-legal-inner">
      <p>
        © {new Date().getFullYear()} Universidad Distrital Francisco José de Caldas — Doctorado en
        Ingeniería
      </p>
      <nav aria-label="Enlaces institucionales">
        <a href="https://www.udistrital.edu.co/" rel="external">udistrital.edu.co</a>
        <a href="/contactenos/">Contáctenos</a>
        <a href="/pqrs/">PQRS</a>
        <a href="/noticias/">Noticias</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--c-ink);
    color: oklch(0.88 0.005 260);
    margin-top: var(--section-gap);
  }

  /* .site-footer delante: las reglas genéricas .site-footer ul/li van
     después en este archivo y ganarían a igual especificidad */
  .site-footer .footer-logos {
    background: var(--c-crimson);
    padding-block: 1.75rem;
  }

  .site-footer .logos {
    padding-inline: var(--gutter); /* el de .container, que .site-footer ul anula */
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem 1.75rem;
  }

  .site-footer .logos li {
    margin: 0;
  }

  .site-footer .logos a {
    display: block;
    transition:
      opacity 180ms var(--ease-out-quint),
      translate 180ms var(--ease-out-quint);
  }

  .site-footer .logos a:hover {
    opacity: 0.85;
    translate: 0 -2px;
  }

  .site-footer .logos img {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  @media (max-width: 560px) {
    .site-footer .logos img {
      height: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer .logos a {
      transition: none;
    }
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(4, 1fr);
    gap: 2.5rem;
    padding-block: 3.5rem;
  }

  .footer-institucional img {
    /* El escudo es tinta oscura sobre transparente: se invierte para fondo oscuro */
    filter: invert(1) brightness(1.6);
    width: 240px;
    height: auto;
    margin-bottom: 1.25rem;
  }

  address {
    font-style: normal;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .footer-snies {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: oklch(0.68 0.005 260);
  }

  .footer-social {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
  }

  .footer-social a {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .site-footer h2 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--c-white);
    margin-bottom: 0.9rem;
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
  }

  .site-footer li {
    margin-bottom: 0.5rem;
  }

  .site-footer a {
    color: oklch(0.88 0.005 260);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .site-footer a:hover {
    color: var(--c-white);
    text-decoration: underline;
  }

  .footer-legal {
    border-top: 1px solid oklch(0.35 0.01 260);
    /* Abajo deja libre el botón flotante del asistente (ChatBot.astro) */
    padding-block: 1.25rem 5.5rem;
    font-size: 0.85rem;
  }

  .footer-legal-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-legal nav {
    display: flex;
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-institucional {
      grid-column: 1 / -1;
    }
  }
</style>
