---
interface Props {
  href: string;
  title: string;
  date: Date;
  image?: string;
  imageAlt?: string;
}

const { href, title, date, image, imageAlt = '' } = Astro.props;
const fecha = date.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="news-card">
  <a href={href}>
    {image && <img src={image} alt={imageAlt} loading="lazy" width="590" height="370" />}
    <div class="news-body">
      <time datetime={date.toISOString().slice(0, 10)}>{fecha}</time>
      <h3>{title}</h3>
    </div>
  </a>
</article>

<style>
  .news-card a {
    display: block;
    text-decoration: none;
    color: var(--c-ink);
    height: 100%;
    background: var(--c-bg);
    border: 1px solid var(--c-line);
    overflow: hidden;
    transition: border-color 200ms var(--ease-out-quint), translate 250ms var(--ease-out-quint),
      box-shadow 250ms var(--ease-out-quint);
  }

  .news-card a:hover {
    border-color: var(--c-crimson);
    translate: 0 -4px;
    box-shadow: 0 14px 32px oklch(0.2 0.01 260 / 0.12);
  }

  .news-card img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    width: 100%;
    transition: scale 450ms var(--ease-out-quint);
  }

  .news-card a:hover img {
    scale: 1.04;
  }

  @media (prefers-reduced-motion: reduce) {
    .news-card a:hover {
      translate: 0 0;
    }

    .news-card a:hover img {
      scale: 1;
    }
  }

  .news-body {
    padding: 1.1rem 1.25rem 1.4rem;
  }

  .news-card time {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--c-ink-soft);
  }

  .news-card h3 {
    font-size: 1.1rem;
    margin-top: 0.4rem;
    line-height: 1.3;
  }

  .news-card a:hover h3 {
    color: var(--c-crimson);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }
</style>
