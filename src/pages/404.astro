---
import Base from '../layouts/Base.astro';
---

<Base
  title="Página no encontrada"
  description="La página solicitada no existe en el sitio del Doctorado en Ingeniería."
>
  <div class="container nf">
    <p class="nf-code">404</p>
    <h1>Página no encontrada</h1>
    <p class="nf-lead">
      La dirección que buscas no existe o cambió de lugar. Puedes buscar el contenido o volver al
      inicio.
    </p>
    <div class="nf-actions">
      <a class="btn btn-primary" href="/">Ir al inicio</a>
      <a class="btn btn-outline-dark" href="/buscar/">Buscar en el sitio</a>
    </div>
  </div>
</Base>

<style>
  .nf {
    padding-block: var(--section-gap);
    text-align: center;
    max-width: 640px;
  }

  .nf-code {
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--c-crimson);
  }

  .nf h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-top: 0.5rem;
  }

  .nf-lead {
    margin-top: 1rem;
    color: var(--c-ink-soft);
    font-size: 1.1rem;
  }

  .nf-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }
</style>
