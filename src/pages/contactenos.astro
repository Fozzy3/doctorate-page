---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contáctenos"
  description="Contacto del Doctorado en Ingeniería de la Universidad Distrital: ubicación, teléfono, correo electrónico y formulario de contacto."
>
  <div class="container contacto">
    <header class="page-header">
      <h1>Contáctenos</h1>
    </header>

    <div class="contacto-grid">
      <section class="datos" aria-label="Datos de contacto">
        <h2>Doctorado en Ingeniería</h2>
        <dl>
          <dt>Ubicación</dt>
          <dd>
            Universidad Distrital Francisco José de Caldas<br />
            Cra. 7 No. 40B-53, Semisótano, Edificio Administrativo<br />
            Bogotá D.C., Colombia
          </dd>
          <dt>Teléfono</dt>
          <dd>(+57) 601 323 9300, extensión 1419</dd>
          <dt>Correo electrónico</dt>
          <dd><a href="mailto:doctoradoing@udistrital.edu.co">doctoradoing@udistrital.edu.co</a></dd>
        </dl>
      </section>

      <form
        class="form"
        method="POST"
        action="https://api.web3forms.com/submit"
        aria-label="Formulario de contacto"
      >
        <!-- Reemplazar con la access key real de Web3Forms antes de publicar -->
        <input type="hidden" name="access_key" value="PENDIENTE_ACCESS_KEY" />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <div class="field">
          <label for="nombre">Nombre completo</label>
          <input id="nombre" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="correo">Correo electrónico</label>
          <input id="correo" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="asunto">Asunto</label>
          <input id="asunto" name="subject" type="text" required />
        </div>
        <div class="field">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="message" rows="6" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Enviar mensaje</button>
        <p class="form-nota">
          Los datos enviados se tratan según la política de protección de datos personales de la
          Universidad Distrital Francisco José de Caldas.
        </p>
      </form>
    </div>
  </div>
</Base>

<style>
  .contacto {
    padding-block: 2.5rem var(--section-gap);
  }

  .page-header {
    border-bottom: 3px solid var(--c-crimson);
    padding-bottom: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 2.7rem);
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .datos {
    background: var(--c-surface);
    border-top: 3px solid var(--c-crimson);
    padding: 1.75rem 2rem;
  }

  .datos h2 {
    font-size: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .datos dt {
    font-weight: 700;
    font-size: 0.9rem;
    margin-top: 1.1rem;
  }

  .datos dd {
    margin-top: 0.3rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--c-ink-soft);
  }

  .field {
    margin-bottom: 1.25rem;
  }

  label {
    display: block;
    font-weight: 650;
    font-size: 0.9375rem;
    margin-bottom: 0.4rem;
  }

  input:not([type='hidden']):not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--c-ink-soft);
    background: var(--c-bg);
    color: var(--c-ink);
  }

  input:focus,
  textarea:focus {
    border-color: var(--c-crimson);
  }

  .form-nota {
    margin-top: 1rem;
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 820px) {
    .contacto-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
