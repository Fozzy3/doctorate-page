---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contáctenos"
  description="Contacto del Doctorado en Ingeniería de la Universidad Distrital: ubicación, teléfono, correo electrónico y formulario de contacto."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Miga de pan">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-current="page">Contáctenos</li>
        </ol>
      </nav>
      <h1 class="display">Contáctenos</h1>
      <p class="page-lead">
        ¿Tienes preguntas sobre el programa, las admisiones o los trámites? Escríbenos.
      </p>
    </div>
  </div>

  <div class="container contacto">
    <div class="contacto-grid">
      <section class="datos" aria-label="Datos de contacto">
        <h2>Doctorado en Ingeniería</h2>
        <dl>
          <div>
            <dt>Ubicación</dt>
            <dd>
              Universidad Distrital Francisco José de Caldas<br />
              Cra. 7 No. 40B-53, Semisótano, Edificio Administrativo<br />
              Bogotá D.C., Colombia
            </dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd>(+57) 601 323 9300, extensión 1419</dd>
          </div>
          <div>
            <dt>Correo electrónico</dt>
            <dd><a href="mailto:doctoradoing@udistrital.edu.co">doctoradoing@udistrital.edu.co</a></dd>
          </div>
        </dl>
      </section>

      <form
        class="form"
        method="POST"
        action="https://api.web3forms.com/submit"
        aria-label="Formulario de contacto"
      >
        <!-- Reemplazar con la access key real de Web3Forms antes de publicar -->
        <input type="hidden" name="access_key" value="PENDIENTE_ACCESS_KEY" />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <div class="fila">
          <div class="field">
            <label for="nombre">Nombre completo</label>
            <input
              id="nombre"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre y apellidos"
            />
          </div>
          <div class="field">
            <label for="correo">Correo electrónico</label>
            <input
              id="correo"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="nombre@correo.com"
            />
          </div>
        </div>
        <div class="field">
          <label for="asunto">Asunto</label>
          <input
            id="asunto"
            name="subject"
            type="text"
            required
            placeholder="¿Sobre qué nos escribes?"
          />
        </div>
        <div class="field">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="message" rows="7" required placeholder="Cuéntanos en detalle"
          ></textarea>
        </div>
        <button class="btn btn-primary" type="submit">
          Enviar mensaje
          <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>
        <p class="form-nota">
          Los datos enviados se tratan según la política de protección de datos personales de la
          Universidad Distrital Francisco José de Caldas.
        </p>
      </form>
    </div>
  </div>
</Base>

<style>
  .page-hero {
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
    padding-block: 1.5rem clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--c-ink-soft);
  }

  .breadcrumbs a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  .page-hero h1 {
    font-size: clamp(2.1rem, 4vw, 3.2rem);
  }

  .page-lead {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  .contacto {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-gap);
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  /* Tarjeta de datos: misma voz que las fichas del sitio */
  .datos {
    background: var(--c-surface);
    border-top: 3px solid var(--c-crimson);
    padding: 1.75rem 2rem 2rem;
    position: sticky;
    top: 90px;
  }

  .datos h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .datos dl div {
    padding-block: 1rem;
  }

  .datos dl div + div {
    border-top: 1px solid var(--c-line);
  }

  .datos dt {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .datos dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--c-ink-soft);
  }

  /* Formulario */
  .fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    margin-bottom: 1.4rem;
  }

  label {
    display: block;
    font-weight: 650;
    font-size: 0.9rem;
    margin-bottom: 0.45rem;
  }

  input:not([type='hidden']):not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--c-line);
    background: var(--c-bg);
    color: var(--c-ink);
    transition: border-color 180ms var(--ease-out-quint), box-shadow 180ms var(--ease-out-quint);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--c-ink-soft);
    opacity: 1;
  }

  input:hover,
  textarea:hover {
    border-color: var(--c-ink-soft);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--c-crimson);
    box-shadow: 0 0 0 3px var(--c-crimson-soft);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn svg {
    transition: translate 150ms var(--ease-out-quint);
  }

  .btn:hover svg {
    translate: 2px -2px;
  }

  .form-nota {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 820px) {
    .contacto-grid,
    .fila {
      grid-template-columns: 1fr;
    }

    .datos {
      position: static;
    }
  }
</style>
