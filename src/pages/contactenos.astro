---
import Base from '../layouts/Base.astro';

// Clave de Web3Forms (servicio que reenvía el formulario al correo del
// programa). Mientras sea el marcador, el envío falla de forma controlada y
// se muestra el correo institucional como alternativa.
const ACCESS_KEY = 'PENDIENTE_ACCESS_KEY';
---

<Base
  title="Contáctenos"
  description="Contacto del Doctorado en Ingeniería de la Universidad Distrital: ubicación, teléfono, correo electrónico y formulario de contacto."
>
  <div class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Miga de pan">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li aria-current="page">Contáctenos</li>
        </ol>
      </nav>
      <h1 class="display">Contáctenos</h1>
      <p class="page-lead">
        ¿Tienes preguntas sobre el programa, las admisiones o los trámites? Escríbenos.
      </p>
    </div>
  </div>

  <div class="container contacto">
    <div class="contacto-grid">
      <section class="datos" aria-label="Datos de contacto">
        <h2>Doctorado en Ingeniería</h2>
        <dl>
          <div>
            <dt>Ubicación</dt>
            <dd>
              Universidad Distrital Francisco José de Caldas<br />
              Cra. 7 No. 40B-53, Semisótano, Edificio Administrativo<br />
              Bogotá D.C., Colombia
            </dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd>(+57) 601 323 9300, extensión 1419</dd>
          </div>
          <div>
            <dt>Correo electrónico</dt>
            <dd><a href="mailto:doctoradoing@udistrital.edu.co">doctoradoing@udistrital.edu.co</a></dd>
          </div>
        </dl>
      </section>

      <form
        id="form-contacto"
        class="form"
        method="POST"
        action="https://api.web3forms.com/submit"
        aria-label="Formulario de contacto"
      >
        {/* Reemplazar con la access key real de Web3Forms antes de publicar.
            Mientras diga PENDIENTE, el envío falla y se muestra el aviso de
            respaldo con el correo del programa. */}
        <input type="hidden" name="access_key" value={ACCESS_KEY} />
        <input
          type="hidden"
          name="subject"
          value="Nuevo mensaje desde el sitio del Doctorado en Ingeniería"
        />
        <input type="hidden" name="from_name" value="Sitio del Doctorado en Ingeniería" />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <div class="fila">
          <div class="field">
            <label for="nombre">Nombre completo</label>
            <input
              id="nombre"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="Tu nombre y apellidos"
            />
          </div>
          <div class="field">
            <label for="correo">Correo electrónico</label>
            <input
              id="correo"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="nombre@correo.com"
            />
          </div>
        </div>
        <div class="field">
          <label for="asunto">Asunto</label>
          <input
            id="asunto"
            name="subject"
            type="text"
            required
            placeholder="¿Sobre qué nos escribes?"
          />
        </div>
        <div class="field">
          <label for="mensaje">Mensaje</label>
          <textarea id="mensaje" name="message" rows="7" required placeholder="Cuéntanos en detalle"
          ></textarea>
        </div>
        <button class="btn btn-primary" type="submit">
          Enviar mensaje
          <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="2"></path>
          </svg>
        </button>

        {/* El resultado del envío se anuncia aquí mismo, sin salir de la página.
            role=status para que los lectores de pantalla lo lean al aparecer. */}
        <p class="form-estado" role="status" aria-live="polite" hidden></p>

        <p class="form-nota">
          Los datos enviados se tratan según la política de protección de datos personales de la
          Universidad Distrital Francisco José de Caldas.
        </p>
      </form>
    </div>
  </div>
</Base>

<style>
  .page-hero {
    background: var(--c-surface);
    border-bottom: 1px solid var(--c-line);
    padding-block: 1.5rem clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
    margin-bottom: 1.25rem;
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--c-ink-soft);
  }

  .breadcrumbs a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  .page-hero h1 {
    font-size: clamp(2.1rem, 4vw, 3.2rem);
  }

  .page-lead {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  .contacto {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section-gap);
  }

  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  /* Tarjeta de datos: misma voz que las fichas del sitio */
  .datos {
    background: var(--c-surface);
    border-top: 3px solid var(--c-crimson);
    padding: 1.75rem 2rem 2rem;
    position: sticky;
    top: 90px;
  }

  .datos h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .datos dl div {
    padding-block: 1rem;
  }

  .datos dl div + div {
    border-top: 1px solid var(--c-line);
  }

  .datos dt {
    font-weight: 700;
    font-size: 0.875rem;
  }

  .datos dd {
    margin-top: 0.35rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--c-ink-soft);
  }

  /* Formulario */
  .fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    margin-bottom: 1.4rem;
  }

  label {
    display: block;
    font-weight: 650;
    font-size: 0.9rem;
    margin-bottom: 0.45rem;
  }

  input:not([type='hidden']):not([type='checkbox']),
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--c-line);
    background: var(--c-bg);
    color: var(--c-ink);
    transition: border-color 180ms var(--ease-out-quint), box-shadow 180ms var(--ease-out-quint);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--c-ink-soft);
    opacity: 1;
  }

  input:hover,
  textarea:hover {
    border-color: var(--c-ink-soft);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--c-crimson);
    box-shadow: 0 0 0 3px var(--c-crimson-soft);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn svg {
    transition: translate 150ms var(--ease-out-quint);
  }

  .btn:hover svg {
    translate: 2px -2px;
  }

  .form-nota {
    margin-top: 1.1rem;
    font-size: 0.8rem;
    color: var(--c-ink-soft);
    max-width: 52ch;
  }

  @media (max-width: 820px) {
    .contacto-grid,
    .fila {
      grid-template-columns: 1fr;
    }

    .datos {
      position: static;
    }
  }

  /* Resultado del envío: verde institucional para éxito, carmesí para error */
  .form-estado {
    margin-top: 1.1rem;
    padding: 0.9rem 1.1rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-left: 0;
  }

  .form-estado.ok {
    background: oklch(0.95 0.04 150);
    color: oklch(0.35 0.09 150);
  }

  .form-estado.error {
    background: var(--c-crimson-soft);
    color: var(--c-crimson-dark);
  }

  .form-estado :global(a) {
    color: inherit;
  }
</style>

<script>
  const form = document.getElementById('form-contacto') as HTMLFormElement | null;
  const estado = form?.querySelector<HTMLParagraphElement>('.form-estado');
  const boton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const CORREO = 'doctoradoing@udistrital.edu.co';

  if (form && estado && boton) {
    const campos = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      'input:not([type="hidden"]):not([type="checkbox"]), textarea'
    );

    // El navegador muestra sus avisos de validación en SU idioma, no en el de
    // la página: se reemplazan por mensajes propios en español.
    const mensajeDe = (campo: HTMLInputElement | HTMLTextAreaElement) => {
      const v = campo.validity;
      if (v.valueMissing) return 'Completa este campo para continuar.';
      if (v.typeMismatch && campo.type === 'email')
        return 'Escribe un correo electrónico válido, por ejemplo nombre@correo.com';
      return 'Revisa este campo.';
    };

    campos.forEach((campo) => {
      campo.addEventListener('invalid', () => campo.setCustomValidity(mensajeDe(campo)));
      // Sin esto el mensaje se queda pegado aunque el campo ya sea válido.
      // `change` además cubre el autocompletado del navegador.
      const limpiar = () => campo.setCustomValidity('');
      campo.addEventListener('input', limpiar);
      campo.addEventListener('change', limpiar);
    });

    const mostrar = (texto: string, ok: boolean) => {
      estado.innerHTML = texto;
      estado.classList.toggle('ok', ok);
      estado.classList.toggle('error', !ok);
      estado.hidden = false;
    };

    // Envío sin salir de la página: el usuario no termina en una pantalla
    // ajena del proveedor y conserva lo que escribió si algo falla.
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      estado.hidden = true;
      boton.disabled = true;
      // innerHTML, no textContent: el botón lleva el ícono de flecha dentro
      const contenidoOriginal = boton.innerHTML;
      boton.textContent = 'Enviando…';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        mostrar('Mensaje enviado. Te responderemos al correo que nos indicaste.', true);
        form.reset();
      } catch {
        mostrar(
          `No pudimos enviar el mensaje. Escríbenos directamente a <a href="mailto:${CORREO}">${CORREO}</a> o llámanos al (+57) 601 323 9300, extensión 1419.`,
          false
        );
      } finally {
        boton.disabled = false;
        boton.innerHTML = contenidoOriginal;
      }
    });
  }
</script>
