---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import NewsSpotlight from '../../components/NewsSpotlight.astro';

const noticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const destacadas = noticias.slice(0, 3);
const resto = noticias.slice(3);
---

<Base
  title="Noticias"
  description="Noticias, convocatorias y anuncios del Doctorado en Ingeniería de la Universidad Distrital Francisco José de Caldas."
>
  <div class="container">
    <header class="page-header">
      <h1 class="display">Noticias</h1>
      <p>Convocatorias, anuncios y actividades del programa.</p>
    </header>

    <NewsSpotlight
      items={destacadas.map((n) => ({
        href: `/noticias/${n.id}/`,
        title: n.data.title,
        date: n.data.date,
        description: n.data.description,
        image: n.data.image,
        imageAlt: n.data.imageAlt,
      }))}
    />

    {
      resto.length > 0 && (
        <div class="news-grid">
          {resto.map((n) => (
            <NewsCard
              href={`/noticias/${n.id}/`}
              title={n.data.title}
              date={n.data.date}
              image={n.data.image}
              imageAlt={n.data.imageAlt}
            />
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .page-header {
    padding-block: 2.5rem 2rem;
    border-bottom: 3px solid var(--c-crimson);
    margin-bottom: 2.5rem;
  }

  .page-header h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.1rem);
  }

  .page-header p {
    margin-top: 0.5rem;
    color: var(--c-ink-soft);
    font-size: 1.05rem;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.75rem;
    margin-top: 3.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--c-line);
  }
</style>
