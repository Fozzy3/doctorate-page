---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((n) => ({ params: { slug: n.id }, props: { n } }));
}

const { n } = Astro.props;
const { Content } = await render(n);
const fecha = n.data.date.toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const otras = (await getCollection('noticias'))
  .filter((o) => o.id !== n.id)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const url = Astro.url.href;
const compartir = [
  {
    label: 'Compartir en Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`,
    icon: 'M9.5 3H12V0H9.5C7 0 5 2 5 4.5V6H2v3h3v7h3V9h3l.5-3H8V4.5C8 3.7 8.7 3 9.5 3z',
  },
  {
    label: 'Compartir en X',
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(n.data.title)}`,
    icon: 'M12.6 0h2.5L9.7 6.8 16 16h-5L7.3 10.7 2.9 16H.4l5.8-7.3L0 0h5.1l3.5 4.9L12.6 0zm-.9 14.4h1.4L4.3 1.5H2.8l8.9 12.9z',
  },
  {
    label: 'Compartir en LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`,
    icon: 'M3.4 1.7a1.7 1.7 0 1 1-3.4 0 1.7 1.7 0 0 1 3.4 0zM.2 5h3V16h-3V5zm5 0h2.9v1.5h.1C8.6 5.7 9.7 4.8 11.3 4.8c3 0 3.6 2 3.6 4.6V16h-3v-5.8c0-1.4 0-3.2-1.9-3.2-1.9 0-2.2 1.5-2.2 3.1V16h-3V5z',
  },
  {
    label: 'Compartir por correo',
    href: `mailto:?subject=${encodeURIComponent(n.data.title)}&body=${encodeURIComponent(url)}`,
    icon: 'M0 2h16v12H0V2zm1.5 1.8v.4L8 9l6.5-4.8v-.4L8 8.6 1.5 3.8zm0 2.2v6.5h13V6L8 10.8 1.5 6z',
  },
];
---

<Base title={n.data.title} description={n.data.description}>
  <div class="container noticia">
    <nav class="breadcrumbs" aria-label="Miga de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/noticias/">Noticias</a></li>
        <li aria-current="page">{n.data.title}</li>
      </ol>
    </nav>

    <article>
      <header>
        <time datetime={n.data.date.toISOString().slice(0, 10)}>{fecha}</time>
        <h1>{n.data.title}</h1>
        <p class="dek">{n.data.description}</p>

        <div class="share" aria-label="Compartir esta noticia">
          {
            compartir.map((s) => (
              <a href={s.href} rel="external noopener" aria-label={s.label}>
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d={s.icon} fill="currentColor" />
                </svg>
              </a>
            ))
          }
          <button type="button" class="share-print" aria-label="Imprimir esta noticia">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path
                d="M4 0h8v4h2.5A1.5 1.5 0 0 1 16 5.5V12h-4v4H4v-4H0V5.5A1.5 1.5 0 0 1 1.5 4H4V0zm1.5 1.5V4h5V1.5h-5zM5.5 10v4.5h5V10h-5zM1.5 10.5H4V8.5h8v2h2.5v-5h-13v5z"
                fill="currentColor"
              />
            </svg>
          </button>
        </div>

        <a class="arrow-link" href="/contactenos/">
          <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
            <path d="M3 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          Contacto del programa
        </a>
      </header>

      {
        n.data.image && (
          <img src={n.data.image} alt={n.data.imageAlt ?? ''} width="1180" height="740" />
        )
      }
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      otras.length > 0 && (
        <aside class="rail" aria-label="Más noticias del programa">
          <p class="rail-title">Más noticias</p>
          {otras.map((o) => (
            <article class="rail-item">
              <a href={`/noticias/${o.id}/`}>
                <time datetime={o.data.date.toISOString().slice(0, 10)}>
                  {o.data.date.toLocaleDateString('es-CO', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    timeZone: 'UTC',
                  })}
                </time>
                <h2>{o.data.title}</h2>
              </a>
            </article>
          ))}
          <a class="rail-all" href="/noticias/">
            Todas las noticias
            <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M2 12L12 2M5 2h7v7" fill="none" stroke="currentColor" stroke-width="2" />
            </svg>
          </a>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .noticia {
    padding-block: 2rem var(--section-gap);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    column-gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  .noticia > .breadcrumbs {
    grid-column: 1 / -1;
  }

  .noticia > article {
    max-width: 820px;
  }

  /* Riel de más noticias */
  .rail {
    position: sticky;
    top: 90px;
    margin-top: 1.75rem;
  }

  .rail-title {
    font-weight: 750;
    font-size: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 3px solid var(--c-crimson);
  }

  .rail-item a {
    display: block;
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    color: var(--c-ink);
  }

  .rail-item time {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
  }

  .rail-item h2 {
    font-size: 1.02rem;
    line-height: 1.35;
    margin-top: 0.3rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--c-line);
  }

  .rail-item a:hover h2 {
    color: var(--c-crimson);
    text-decoration-color: var(--c-crimson);
    text-decoration-thickness: 2px;
  }

  .rail-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .rail-all:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 1100px) {
    .noticia {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail {
      position: static;
      max-width: 620px;
      margin-top: 3rem;
    }
  }

  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-ink-soft);
  }

  .breadcrumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--c-line);
  }

  .breadcrumbs a {
    color: var(--c-ink-soft);
    text-decoration: none;
  }

  article header {
    margin: 1.75rem 0 2rem;
  }

  article time {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--c-ink-soft);
  }

  article h1 {
    font-size: clamp(2rem, 4.5vw, 3.1rem);
    margin-top: 0.6rem;
    max-width: 24ch;
  }

  .dek {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    font-weight: 450;
    line-height: 1.5;
    color: var(--c-ink-soft);
    max-width: 56ch;
    text-wrap: pretty;
  }

  .share {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .share a,
  .share-print {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--c-surface);
    color: var(--c-ink);
    border: 1px solid var(--c-line);
    cursor: pointer;
    transition: background-color 150ms var(--ease-out-quint), color 150ms var(--ease-out-quint),
      border-color 150ms var(--ease-out-quint);
  }

  .share a:hover,
  .share-print:hover {
    background: var(--c-crimson);
    border-color: var(--c-crimson);
    color: var(--c-white);
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }

  .arrow-link:hover {
    text-decoration-thickness: 2px;
  }

  article > img {
    margin-bottom: 1.75rem;
    border: 1px solid var(--c-line);
  }

  @media print {
    .share,
    .breadcrumbs,
    .arrow-link,
    .rail {
      display: none;
    }
  }
</style>

<script>
  document
    .querySelector<HTMLButtonElement>('.share-print')
    ?.addEventListener('click', () => window.print());
</script>
