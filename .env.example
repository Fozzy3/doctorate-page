# URL base de la API de certificados (certificados-api), sin barra final.
# Se incrusta en el build: el sitio es estático.
# - Desarrollo: si no se define, la página usa http://localhost:8000/api/v1.
# - Producción/CI: se toma de la variable del repositorio PUBLIC_CERT_API_URL
#   (Settings → Secrets and variables → Actions → Variables). Debe ser HTTPS:
#   el sitio es HTTPS y el navegador bloquea llamadas a HTTP (contenido mixto).
#   Sin la variable, la página no llama a nada y muestra el correo del programa.
PUBLIC_CERT_API_URL=http://localhost:8000/api/v1
